# Copy to .env (git-ignored) or set these in the deploy tool. Every value here is a placeholder.

# The hosted curator (docker-compose.yml): the one basic-auth login, for the browser and the clients.
STILLSTIFT_AUTH_USER=change-me
STILLSTIFT_AUTH_PASSWORD=change-me

# Who can rate, comma-separated; picked in the header once logged in, so the shared login still
# knows who is rating. Required to start the curator.
STILLSTIFT_RATERS=Sven,Anna

# `just render`, `just score` and `just sheet` use the hosted curator when this is set.
# STILLSTIFT_CURATOR_URL=https://curator.example.org
# STILLSTIFT_CURATOR_USER=change-me
# STILLSTIFT_CURATOR_PASSWORD=change-me

# The project's own ComfyUI on this PC (`just render`): its address, and the output folder it is
# started with (--output-directory); the render step refuses any other ComfyUI.
# STILLSTIFT_COMFY_URL=http://127.0.0.1:8189
# STILLSTIFT_COMFY_OUTPUT=D:\Stillstift\outputs

# `just models`: the ComfyUI models folder, and this project's own download tokens.
# STILLSTIFT_COMFY_MODELS=D:\Stillstift\ComfyUI\models
# STILLSTIFT_HF_TOKEN=change-me
# STILLSTIFT_CIVITAI_TOKEN=change-me

# Where the SQLite file and the images live. The container sets /data; locally it defaults to data.
# STILLSTIFT_DATA=data