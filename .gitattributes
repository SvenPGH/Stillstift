# LF in every checkout, whatever core.autocrlf says. Git for Windows defaults
# to CRLF, which breaks every bash script (`$'\r': command not found`) and
# fails the formatters (prettier, pint, stylua all check for LF).
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.phar binary
